# LLM Provider API Keys for LLM Docs Hook
# Copy this file to .env and add your API key
# These environment variables are prefixed with LLM_DOCS_HOOK_ to avoid conflicts with other tools

# OpenAI (default provider)
LLM_DOCS_HOOK_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
# LLM_DOCS_HOOK_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Mistral
# LLM_DOCS_HOOK_MISTRAL_API_KEY=your_mistral_api_key_here

# Google
# LLM_DOCS_HOOK_GOOGLE_API_KEY=your_google_api_key_here

# Generic fallback
# LLM_DOCS_HOOK_API_KEY=your_api_key_here
